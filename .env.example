NODE_ENV=development
PORT=3000

# Demostración local; cambia estos valores para cualquier entorno compartido.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=inventory
DB_USERNAME=inventory
DB_PASSWORD=inventory_local_only
DB_SCHEMA=public
DB_SSL=false

# Solo crea usuarios que aún no existan; no reinicia contraseñas.
SEED_ADMIN_PASSWORD=change-admin-password
SEED_OPERATOR_PASSWORD=change-operator-password

# JWT_SECRET no se incluye: genéralo con el comando del README, que lo añade a .env.
# Nunca reutilices una clave local en producción ni la publiques.

# Proxies de confianza delante de la API: 0 en local, 1 en Railway.
TRUST_PROXY_HOPS=0
